# Google Analytics 4 Measurement ID (the "Google tag").
# Find this in Google Analytics → Admin → Data Streams → your stream → "Measurement ID".
# When unset, no GA script is injected (useful for local development and previews).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager container ID.
# Find this in Tag Manager → Admin → Container Settings → "Container ID".
# When unset, GTM is not loaded.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta (Facebook) Pixel ID — the 15–16 digit number.
# Find this in Meta Events Manager → your Pixel → "Pixel ID".
# When unset, the pixel is not loaded.
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
